# Base URL of the FastAPI backend (backend/main.py). Defaults to
# http://127.0.0.1:8000 if unset -- see src/lib/api.ts.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Base URL of the voice anti-spoofing service (voice-integrity/src/server.py).
# Defaults to http://127.0.0.1:8001 if unset -- see src/lib/voiceCheck.ts.
VITE_VOICE_API_BASE_URL=http://127.0.0.1:8001
